					"name": "Create Project",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"TaskFlow Release v1\",\n  \"description\": \"Full-stack Kanban application build\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/projects",
							"host": ["{{base_url}}"],
							"path": ["api", "projects"]
						}
					}
				},
				{
					"name": "Get Project Tasks (with Search & Filter)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/projects/:projectId/tasks?status=IN_PROGRESS&priority=HIGH&search=JWT",
							"host": ["{{base_url}}"],
							"path": ["api", "projects", ":projectId", "tasks"],
							"query": [
								{ "key": "status", "value": "IN_PROGRESS" },
								{ "key": "priority", "value": "HIGH" },
								{ "key": "search", "value": "JWT" }
							],
							"variable": [
								{ "key": "projectId", "value": "PROJECT_ID_HERE" }
							]
						}
					}
				},
				{
					"name": "Create Task",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Implement Drag & Drop Kanban\",\n  \"description\": \"Use TanStack Query for cache invalidation & optimistic updates\",\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"HIGH\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/projects/:projectId/tasks",
							"host": ["{{base_url}}"],
							"path": ["api", "projects", ":projectId", "tasks"],
							"variable": [
								{ "key": "projectId", "value": "PROJECT_ID_HERE" }
							]
